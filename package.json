{
	"name": "foodmap",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.11.1",
	"scripts": {
		"dev": "npm run build:restaurants && vite dev",
		"build": "npm run build:restaurants && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"build:restaurants": "node scripts/build-restaurants-data.js"
	},
	"devDependencies": {
		"@picocss/pico": "^2.1.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"maplibre-gl": "^4.7.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"svelte-maplibre-gl": "^1.0.3",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vite-plugin-pwa": "^1.2.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
